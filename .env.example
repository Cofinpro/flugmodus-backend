# Kopieren nach .env und anpassen
# Öffentliche Adresse dieses Backends (z. B. ngrok) – steht im Anmelden-QR und im Registrieren-Link
BACKEND_PUBLIC_URL=https://example.ngrok-free.dev/
# Öffentliche Adresse der Frontend-App – der Registrieren-QR führt auf <FRONTEND_URL>signup
FRONTEND_URL=https://cofinpro.github.io/flugmodus-frontend/
